{
  "name": "quizvibe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "QuizVibe content catalog and (later) image-generation/admin pipeline.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx content/registry.ts",
    "demo": "tsx demo.ts",
    "wikimedia-search": "tsx wikimedia/suggest.ts",
    "wikimedia-process": "tsx wikimedia/process.ts",
    "youtube-search": "tsx --env-file=.env.local youtube/suggest.ts",
    "youtube-validate": "tsx --env-file=.env.local youtube/validate.ts",
    "export-demo": "tsx scripts/export-demo.ts",
    "export-music-questions": "tsx scripts/export-music-questions.ts",
    "export-image-questions": "tsx scripts/export-image-questions.ts",
    "measure-images": "tsx scripts/measure-images.ts",
    "build": "tsc"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.0"
  }
}
