{
  "name": "quizvibe-backend",
  "version": "0.1.0",
  "private": true,
  "description": "QuizVibe content catalog and (later) image-generation/admin pipeline.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "tsx content/registry.ts",
    "demo": "tsx demo.ts",
    "wikimedia-search": "tsx wikimedia/suggest.ts",
    "wikimedia-process": "tsx wikimedia/process.ts",
    "youtube-search": "tsx --env-file=.env.local youtube/suggest.ts",
    "youtube-validate": "tsx --env-file=.env.local youtube/validate.ts",
    "youtube-autofix": "tsx --env-file=.env.local youtube/autofix.ts",
    "spotify-identity-audit": "tsx scripts/audit-spotify-track-identity.ts",
    "spotify-validate": "tsx scripts/validate-spotify-tracks.ts",
    "spotify-album-audit": "tsx scripts/audit-spotify-album-context.ts",    "export-music-questions": "tsx scripts/export-music-questions.ts",
    "export-image-questions": "tsx scripts/export-image-questions.ts",
    "fetch-hints-data": "tsx scripts/fetch-hints-data.ts",
    "fetch-hints-data-dry": "tsx scripts/fetch-hints-data.ts --dry",
    "fetch-hints-data-resume": "tsx scripts/fetch-hints-data.ts --resume",
    "fetch-person-gender": "tsx scripts/fetch-person-gender.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "js-yaml": "^4.1.0",
    "potrace": "^2.1.8",
    "sharp": "^0.33.5",
    "svg-path-properties": "^2.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.0"
  }
}
