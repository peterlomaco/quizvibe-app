{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true
  },
  "include": ["content/**/*.ts", "wikimedia/**/*.ts", "scripts/**/*.ts", "demo.ts"],
  "exclude": ["node_modules", "dist"]
}
