EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxx

# RevenueCat IAP — public API-keys per platform (Project Settings → API Keys
# i RevenueCat Dashboard). iOS-keyen krävs för first launch; Android sätts
# senare. Om keyen saknas är IAP en no-op (StoreScreen visar mock-flow).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxx
